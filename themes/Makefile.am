## Makefile.am for gtk+/themes
##
## The themes that come with the toolkit itself, each installed as
## $(datadir)/themes/<Theme>/gtk-1.4/gtkrc.

altusdir = $(datadir)/themes/Altus/gtk-1.4
altus_DATA = Altus/gtkrc

altusdarkdir = $(datadir)/themes/Altus-Dark/gtk-1.4
altusdark_DATA = Altus-Dark/gtkrc

clarusdir = $(datadir)/themes/Clarus/gtk-1.4
clarus_DATA = Clarus/gtkrc

clarusdarkdir = $(datadir)/themes/Clarus-Dark/gtk-1.4
clarusdark_DATA = Clarus-Dark/gtkrc

fabricadir = $(datadir)/themes/Fabrica/gtk-1.4
fabrica_DATA = Fabrica/gtkrc

fabricadarkdir = $(datadir)/themes/Fabrica-Dark/gtk-1.4
fabricadark_DATA = Fabrica-Dark/gtkrc

fenestrammdir = $(datadir)/themes/FenestraMM/gtk-1.4
fenestramm_DATA = FenestraMM/gtkrc

fenestrammdarkdir = $(datadir)/themes/FenestraMM-Dark/gtk-1.4
fenestrammdark_DATA = FenestraMM-Dark/gtkrc

gelidusdir = $(datadir)/themes/Gelidus/gtk-1.4
gelidus_DATA = Gelidus/gtkrc

gelidusdarkdir = $(datadir)/themes/Gelidus-Dark/gtk-1.4
gelidusdark_DATA = Gelidus-Dark/gtkrc

metallumdir = $(datadir)/themes/Metallum/gtk-1.4
metallum_DATA = Metallum/gtkrc

metallumdarkdir = $(datadir)/themes/Metallum-Dark/gtk-1.4
metallumdark_DATA = Metallum-Dark/gtkrc

unicusdir = $(datadir)/themes/Unicus/gtk-1.4
unicus_DATA = Unicus/gtkrc

unicusdarkdir = $(datadir)/themes/Unicus-Dark/gtk-1.4
unicusdark_DATA = Unicus-Dark/gtkrc

priscusdir = $(datadir)/themes/Priscus/gtk-1.4
priscus_DATA = Priscus/gtkrc

priscusdarkdir = $(datadir)/themes/Priscus-Dark/gtk-1.4
priscusdark_DATA = Priscus-Dark/gtkrc

EXTRA_DIST = $(altus_DATA) $(altusdark_DATA) $(clarus_DATA) $(clarusdark_DATA) $(fabrica_DATA) $(fabricadark_DATA) $(fenestramm_DATA) $(fenestrammdark_DATA) $(gelidus_DATA) $(gelidusdark_DATA) $(metallum_DATA) $(metallumdark_DATA) $(unicus_DATA) $(unicusdark_DATA) $(priscus_DATA) $(priscusdark_DATA)
