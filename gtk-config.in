#!/bin/sh
#
# gtk-config answers from the pkg-config files installed with GTK+,
# so the two always agree.

prefix=@prefix@
exec_prefix=@exec_prefix@
exec_prefix_set=no

PKG_CONFIG=${PKG_CONFIG:-pkg-config}
PKG_CONFIG_PATH=@libdir@/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}
export PKG_CONFIG_PATH

usage()
{
        cat <<EOF
Usage: gtk-config [OPTIONS] [LIBRARIES]
Options:
        [--prefix[=DIR]]
        [--exec-prefix[=DIR]]
        [--version]
        [--libs]
        [--cflags]
Libraries:
        gtk
        gthread
        gtkgl
EOF
        exit $1
}

if test $# -eq 0; then
        usage 1 1>&2
fi

modules=gtk+-1.4
defines=
while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *) optarg= ;;
  esac

  case $1 in
    --prefix=*)
      prefix=$optarg
      defines="$defines --define-variable=prefix=$optarg"
      if test $exec_prefix_set = no ; then
        exec_prefix=$optarg
      fi
      ;;
    --prefix)
      echo_prefix=yes
      ;;
    --exec-prefix=*)
      exec_prefix=$optarg
      exec_prefix_set=yes
      defines="$defines --define-variable=exec_prefix=$optarg"
      ;;
    --exec-prefix)
      echo_exec_prefix=yes
      ;;
    --version)
      echo_version=yes
      ;;
    --cflags)
      echo_cflags=yes
      ;;
    --libs)
      echo_libs=yes
      ;;
    gtk)
      ;;
    gthread)
      modules="$modules gthread-1.4"
      ;;
    gtkgl)
      modules="$modules gtkgl-1.4"
      ;;
    *)
      usage 1 1>&2
      ;;
  esac
  shift
done

if ! $PKG_CONFIG --exists $modules; then
        echo "gtk-config: pkg-config cannot find $modules" 1>&2
        exit 1
fi

if test "$echo_version" = "yes"; then
        $PKG_CONFIG --modversion gtk+-1.4
        exit 0
fi
if test "$echo_prefix" = "yes"; then
        echo $prefix
fi
if test "$echo_exec_prefix" = "yes"; then
        echo $exec_prefix
fi
if test "$echo_cflags" = "yes"; then
        $PKG_CONFIG $defines --cflags $modules
fi
if test "$echo_libs" = "yes"; then
        $PKG_CONFIG $defines --libs $modules
fi
