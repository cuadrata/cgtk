# makeenums.awk - write GTK+'s enumeration tables
#
# Usage: awk -v mode=defs   [-v incdir=DIR] -f makeenums.awk HEADER...
#        awk -v mode=arrays [-v incdir=DIR] -f makeenums.awk HEADER...
#
# Reads each "typedef enum { ... } Name;" in the headers. With
# mode=defs it writes the enumerations as gtk.defs expects them:
#
#   (define-enum GtkName
#      (nick GTK_VALUE) ...)
#
# and with mode=arrays the GtkEnumValue tables gtktypebuiltins_evals.c
# holds. An enumeration is written as flags if it says so or any value
# is a shift. A value's nick is its name without the prefix all the
# names share, in lower case with '-' for '_'. Comments of the form
# /*< ... >*/ set options: after "typedef enum", flags and prefix=; after
# a value, skip, and nick=. "#include <file>" in a body reads values
# from incdir/file; incdir defaults to "..".
#
# POSIX awk; this replaces makeenums.pl, whose output it reproduces.

BEGIN {
  if (mode == "defs")
    printf ";; generated by makeenums.awk  ; -*- scheme -*-\n\n";
  else if (mode == "arrays")
    printf "/* generated by makeenums.awk */\n\n";
  else {
    print "makeenums.awk: set mode to defs or arrays with -v" > "/dev/stderr";
    failed = 1;
    exit 1;
  }
  WS = "[ \t\n\r\f\v]";
  if (incdir == "")
    incdir = "..";
}

# Read the next line of src, or of the input if src is "", into the
# global line; 0 at the end.
function next_line(src)
{
  if (src == "")
    return (getline line) > 0;
  return (getline line < src) > 0;
}

function ltrim(s)
{
  sub("^" WS "+", "", s);
  return s;
}

# Whether s has a comment opened and not closed.
function open_comment(s,    i, j, last)
{
  last = 0;
  for (i = 1; (j = index(substr(s, i), "/*")) > 0; i += j + 1)
    last = i + j - 1;
  return last && !index(substr(s, last + 2), "*/");
}

# s without its comments, except the /*< ... >*/ options.
function strip_comments(s,    out, i, rest, e)
{
  out = "";
  while ((i = index(s, "/*")) > 0) {
    rest = substr(s, i + 2);
    if (substr(rest, 1, 1) == "<" || !(e = index(rest, "*/"))) {
      out = out substr(s, 1, i);
      s = substr(s, i + 1);
      continue;
    }
    out = out substr(s, 1, i - 1);
    s = substr(rest, e + 2);
  }
  return out s;
}

# Parse "key=value, key, ..." into opt[], which is emptied first.
function parse_options(s,    n, parts, i, k, v)
{
  split("", opt);
  n = split(s, parts, WS "*," WS "*");
  for (i = 1; i <= n; i++) {
    if (!match(parts[i], /[A-Za-z0-9_]+/))
      continue;
    k = substr(parts[i], RSTART, RLENGTH);
    v = substr(parts[i], RSTART + RLENGTH);
    if (substr(v, 1, 1) == "=" && match(v, /^=[^ \t\n\r\f\v]+/))
      v = substr(v, 2, RLENGTH - 1);
    else
      v = 1;
    opt[k] = v;
  }
}

# Parse one line of an enumeration's body. Returns 1 once it has read
# the closing "} Name", 0 otherwise.
function parse_entry(s,    name, value, rest, options, i, e, c)
{
  if (match(s, "^" WS "*}" WS "*[A-Za-z0-9_]+")) {
    enumname = substr(s, RSTART, RLENGTH);
    sub("^" WS "*}" WS "*", "", enumname);
    return 1;
  }

  rest = ltrim(s);
  if (!match(rest, /^[A-Za-z0-9_]+/)) {
    print "Can't understand: " s > "/dev/stderr";
    return 0;
  }
  name = substr(rest, 1, RLENGTH);
  rest = ltrim(substr(rest, RLENGTH + 1));

  # = value, up to a comma or a comment
  value = "";
  if (substr(rest, 1, 1) == "=") {
    rest = substr(rest, 2);
    for (i = 1; i <= length(rest); i++) {
      c = substr(rest, i, 1);
      if (c == "," || (c == "/" && substr(rest, i + 1, 1) == "*"))
        break;
    }
    value = substr(rest, 1, i - 1);
    rest = substr(rest, i);
    if (index(value, "<<") && !has_flags)
      seen_bitshift = 1;
  }
  if (substr(rest, 1, 1) == ",")
    rest = substr(rest, 2);
  rest = ltrim(rest);

  options = "";
  has_options = 0;
  if (substr(rest, 1, 3) == "/*<") {
    e = index(substr(rest, 4), "*/");
    if (e && substr(rest, 3 + e - 1, 1) == ">") {
      options = substr(rest, 4, e - 2);
      rest = ltrim(substr(rest, 3 + e + 2));
      has_options = 1;
    }
  }
  if (rest != "") {
    print "Can't understand: " s > "/dev/stderr";
    return 0;
  }

  if (has_options) {
    parse_options(options);
    if ("skip" in opt)
      return 0;
    nentries++;
    entry_name[nentries] = name;
    entry_nick[nentries] = ("nick" in opt) ? opt["nick"] : "";
    entry_has_nick[nentries] = ("nick" in opt);
  } else {
    nentries++;
    entry_name[nentries] = name;
    entry_nick[nentries] = "";
    entry_has_nick[nentries] = 0;
  }
  return 0;
}

# Read an enumeration's body from src, or from the input if src is "",
# to its closing "} Name". Returns 1 once it has read that. A body can
# #include <file> a list of values, read from incdir/file.
function parse_body(src,    s, inc)
{
  while (next_line(src)) {
    s = line;
    while (open_comment(s)) {
      if (!next_line(src)) {
        print "Unmatched comment" > "/dev/stderr";
        exit 1;
      }
      s = s "\n" line;
    }
    s = strip_comments(s);
    sub(/\n/, " ", s);
    if (s ~ ("^" WS "*$"))
      continue;
    if (match(s, /^#include[ \t]*<[^>]*>/)) {
      inc = substr(s, RSTART, RLENGTH);
      sub(/^#include[ \t]*</, "", inc);
      sub(/>$/, "", inc);
      inc = incdir "/" inc;
      if ((getline line < inc) < 0) {
        print "makeenums.awk: cannot open " inc > "/dev/stderr";
        exit 1;
      }
      close(inc);
      if (parse_body(inc)) {
        close(inc);
        return 1;
      }
      close(inc);
      continue;
    }
    if (parse_entry(s))
      return 1;
  }
  return 0;
}

function common_prefix(a, b,    n, i)
{
  n = length(a) < length(b) ? length(a) : length(b);
  for (i = 1; i <= n && substr(a, i, 1) == substr(b, i, 1); i++)
    ;
  return substr(a, 1, i - 1);
}

# GtkCTreeLineStyle -> gtk_ctree_line_style
function value_name(s,    out, i, c, d)
{
  out = "";
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1);
    d = substr(s, i + 1, 1);
    if (c !~ /[A-Z]/ && d ~ /[A-Z]/) {
      out = out c "_" d;
      i++;
    } else
      out = out c;
  }
  s = out;
  out = "";
  for (i = 1; i <= length(s); i++) {
    if (substr(s, i, 4) ~ /^[A-Z][A-Z][A-Z][0-9a-z]$/) {
      out = out substr(s, i, 2) "_" substr(s, i + 2, 2);
      i += 3;
    } else
      out = out substr(s, i, 1);
  }
  return tolower(out);
}

FNR == 1 {
  first_enum = 1;
}

$0 ~ ("^" WS "*typedef" WS "+enum") {
  rest = $0;
  sub("^" WS "*typedef" WS "+enum" WS "*", "", rest);
  brace = 0;
  if (substr(rest, 1, 1) == "{") {
    brace = 1;
    rest = ltrim(substr(rest, 2));
  }
  prefix = "";
  has_prefix = 0;
  has_flags = 0;
  flags = 0;
  if (substr(rest, 1, 3) == "/*<" && (e = index(substr(rest, 4), ">*/"))) {
    parse_options(substr(rest, 4, e - 1));
    if ("prefix" in opt) {
      prefix = opt["prefix"];
      has_prefix = 1;
    }
    if ("flags" in opt) {
      flags = opt["flags"];
      has_flags = 1;
    }
  }
  # Without a '{' after "enum", the body starts after the next line
  # that opens with one.
  if (!brace)
    while (next_line())
      if (line ~ ("^" WS "*{"))
        break;

  seen_bitshift = 0;
  nentries = 0;
  split("", entry_name);
  split("", entry_nick);
  split("", entry_has_nick);
  parse_body("");

  if (!has_flags)
    flags = seen_bitshift;

  if (!has_prefix && nentries > 0) {
    prefix = entry_name[1];
    for (i = 2; i <= nentries; i++)
      prefix = common_prefix(prefix, entry_name[i]);
    # Trim so that it ends in an underscore
    sub(/_[^_]*$/, "_", prefix);
  }

  for (i = 1; i <= nentries; i++)
    if (!entry_has_nick[i]) {
      nick = entry_name[i];
      if (substr(nick, 1, length(prefix)) == prefix)
        nick = substr(nick, length(prefix) + 1);
      gsub(/_/, "-", nick);
      entry_nick[i] = tolower(nick);
    }

  if (mode == "defs") {
    if (first_enum) {
      printf "\n; enumerations from \"%s\"\n", FILENAME;
      first_enum = 0;
    }
    printf "\n(define-%s %s", (flags ? "flags" : "enum"), enumname;
    for (i = 1; i <= nentries; i++)
      printf "\n   (%s %s)", entry_nick[i], entry_name[i];
    printf ")\n";
  } else {
    printf "static const GtkEnumValue _%s_values[] = {\n", value_name(enumname);
    for (i = 1; i <= nentries; i++)
      printf "  { %s, \"%s\", \"%s\" },\n", entry_name[i], entry_name[i], entry_nick[i];
    printf "  { 0, NULL, NULL }\n};\n";
  }
}

END {
  if (failed)
    exit 1;
}
